{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "build"
            ]
        },
        {
            "label": "build",
            "type": "shell",
            "command": "odin",
            "args": [
                "build",
                "${workspaceFolder}",
                "-debug",
                "-out:${workspaceFolder}/build/myapp_debug"
            ],
            "group": "build",
        },
        {
            "label": "Build",
            "dependsOn": [
                "mkdir",
                "build"
            ]
        }
    ]
}